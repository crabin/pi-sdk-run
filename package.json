{
  "name": "data-agent-streaming",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Standalone streaming DataAgent web and CLI example",
  "files": ["dist", "public", "data", "skills", "README.md"],
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "cli": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "start:prod": "node dist/src/index.js",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "format:check": "node scripts/format-check.mjs",
    "eval": "node --import tsx --test test/eval.test.ts",
    "check": "npm run format:check && npm test && npm run typecheck && npm run build"
  },
  "engines": { "node": ">=20.19" },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.83.0",
    "express": "5.2.1",
    "typebox": "1.1.39"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "jsdom": "26.1.0",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  }
}
